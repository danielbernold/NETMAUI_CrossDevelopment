<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="NETMAUI_App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:NETMAUI_App"
    xmlns:views="clr-namespace:NETMAUI_App.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="NETMAUI_App">

    <TabBar>
        <!-- Startseite -->
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate views:HomePage}" />

        <!-- Navigation-Ziel -->
        <ShellContent
            Title="Detail"
            Route="detail"
            ContentTemplate="{DataTemplate views:DetailPage}" />

        <ShellContent
            Title="Search"
            Route="search"
            ContentTemplate="{DataTemplate views:Search}" />

        <ShellContent
            Title="Card"
            Route="card"
            ContentTemplate="{DataTemplate views:CardPage}" />

        <ShellContent
            Title="Posts"
            Route="posts"
            ContentTemplate="{DataTemplate views:PostPage}" />

    </TabBar>

</Shell>
